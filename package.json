{
  "name": "zed-i18n-lens",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Zed extension + language server for configurable i18n inlay hints, hover, completion, diagnostics, and definition.",
  "bin": {
    "zed-i18n-lens-lsp": "./server/index.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node server/index.js",
    "build:server": "esbuild server/index.js --bundle --platform=node --target=node18 --format=cjs --outfile=server/dist/i18n-lens-server.cjs"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
