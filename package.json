{
  "name": "i18n-lens-language-server",
  "version": "0.14.0",
  "type": "module",
  "description": "Language server for configurable i18n inlay hints, hover, completion, diagnostics, definition, and references in Vue/TS/TSX/JS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yizixu/zed-i18n-lens.git"
  },
  "main": "server/index.js",
